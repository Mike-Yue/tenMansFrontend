# Backend API base URL. VITE_ vars are embedded into the build and are public.
# Leave EMPTY so the app always calls relative /api paths. That keeps everything
# same-origin, which is required for the Steam session cookie to work:
#   - dev:  Vite proxies /api -> http://localhost:8080 (see vite.config.ts)
#   - prod: a Render static-site rewrite proxies /api/* -> the backend service
# Do not point this at the backend's own origin, or requests become cross-origin
# and the session cookie is dropped.
VITE_API_BASE_URL=
