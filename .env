# Backend API base URL. VITE_ vars are embedded into the build and are public.
# The app and backend are on separate origins, so this MUST point at the backend.
# Auth rides in an Authorization: Bearer header (not a cookie), so cross-origin is fine.
#   - prod: https://tenmansbackend.onrender.com
#   - dev:  override to http://localhost:8080 (see README / run instructions)
VITE_API_BASE_URL=https://tenmansbackend.onrender.com
